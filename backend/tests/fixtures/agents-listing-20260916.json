          "agent_guid": "00000000-0000-0000-0000-000000000021",
          "created_at": 1771625786,
          "definition": {
            "instructions": "You are an orchestration agent with access to:\n\n1) fabric_data_agent → retrieve business data\n2) sendmail → send emails\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━\nDATA QUESTIONS\n━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nIf the user asks about:\nMRR, NPS, revenue, leads, customers, pipeline,\nsales, churn, financials, KPIs, performance\n\nYou MUST call fabric_data_agent.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━\nEMAIL QUESTIONS\n━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nIf the user asks to:\nsend, notify, inform, email someone\n\nYou MUST call sendmail.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━\nMULTI-STEP ACTIONS\n━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nIf the user asks to retrieve data AND send it by email:\n\nStep 1 → call fabric_data_agent  \nStep 2 → call sendmail with the result\n\nYou are NOT allowed to call sendmail unless the user explicitly asks for an email.",
            "kind": "prompt",
            "model": "gpt-4.1",
            "tools": [
              {
                "openapi": {
                  "auth": {
                    "security_scheme": {},
                    "type": "anonymous"
                  },
                  "description": "sendmail",
                  "name": "sendmail",
                  "spec": {
                    "info": {
                      "description": "Envia e-mail via Azure Logic Apps (HTTP Trigger)",
                      "title": "SendMail Logic Apps",
                      "version": "1.0.0"
                    },
                    "openapi": "3.0.3",
                    "paths": {
                      "/workflows/ff32f8c7c55a44479f41f0f9da5d8290/triggers/When_an_HTTP_request_is_received/paths/invoke": {
                        "post": {
                          "operationId": "sendmail",
                          "parameters": [
                            {
                              "in": "query",
                              "name": "api-version",
                              "required": true,
                              "schema": {
                                "default": "2016-10-01",
                                "type": "string"
                              }
                            },
                            {
                              "in": "query",
                              "name": "sp",
                              "required": true,
                              "schema": {
                                "default": "/triggers/When_an_HTTP_request_is_received/run",
                                "type": "string"
                              }
                            },
                            {
                              "in": "query",
                              "name": "sv",
                              "required": true,
                              "schema": {
                                "default": "1.0",
                                "type": "string"
                              }
                            },
                            {
                              "in": "query",
                              "name": "sig",
                              "required": true,
                              "schema": {
                                "type": "string"
                              }
                            }
                          ],
                          "requestBody": {
                            "content": {
                              "application/json": {
                                "schema": {
                                  "additionalProperties": false,
                                  "properties": {
                                    "attachments": {
                                      "default": [],
                                      "items": {
                                        "properties": {
                                          "ContentBytes": {
                                            "type": "string"
                                          },
                                          "Name": {
                                            "type": "string"
                                          }
                                        },
                                        "required": [
                                          "Name",
                                          "ContentBytes"
                                        ],
                                        "type": "object"
                                      },
                                      "type": "array"
                                    },
                                    "bcc": {
                                      "description": "BCC separados por ;",
                                      "type": "string"
