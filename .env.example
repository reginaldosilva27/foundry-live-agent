# .env.example — committed template of the configuration this project expects.
# Copy to .env and fill in real values:  cp .env.example .env
# The real .env is gitignored and MUST NEVER be committed (constitution §5).
#
# NOTE: every AZURE call authenticates with Microsoft Entra ID via DefaultAzureCredential
# — run `az login` first. There is exactly ONE key in this file, TAVILY_API_KEY, for a
# third-party service with no Entra path; the reason is spelled out where it appears. If you
# find yourself adding a key for an AZURE service, that is a design smell: check the constitution.

# --- Foundry project ------------------------------------------------------
# Format: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
# Reference environment: resource foundry-analytics-demo, project proj-default, region eastus.
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_PROJECT_NAME=your-project
FOUNDRY_REGION=eastus

# Model deployment alias. gpt-5.5 supports reasoning summaries and interleaved thinking,
# which is what makes the Agent activity panel interesting.
#
# IMPORTANT: when the agent's inference runs through your own APIM gateway (see below),
# this becomes "<connection-name>/<model-name>". A PLAIN name means the agent uses a normal
# Foundry deployment and BYPASSES your gateway entirely -- which is easy to do by accident.
# `apply_agent.py` prints which of the two you are on, every run.
#
# The default below is a PLAIN name on purpose: no reference environment has a working
# bring-your-own-model connection yet, so the gateway hop is unverified (docs/REFERENCES.md).
#
# Reasoning summaries are NOT configured here -- they live on the agent definition, in
# ai/harness/prompt_agent/agent.yaml. Observed 2026-09-15: sending `reasoning` on the request
# next to an agent reference is rejected with 400 "Not allowed when agent is specified".
FOUNDRY_MODEL_DEPLOYMENT=gpt-5.5

# --- AI Gateway (APIM) — routing the AGENT's inference ---------------------
# There are two different things called "AI Gateway" and only one of them governs the agent:
#
#   Project AI Gateway (Manage > AI Gateway)  -> governs DIRECT model calls. The Agent
#                                                Service does NOT route its inference here.
#   Bring your own model (BYOM)               -> governs the AGENT's inference. This is the one.
#
# BYOM setup: Manage > Resource details > Admin-connected models > Add > Azure API Management.
# Base URL is the gateway BASE PATH ONLY -- Foundry appends chat/completions itself.
FOUNDRY_GATEWAY_BASE_URL=https://ai-gateway-foundry-analytics-demo.azure-api.net
# The Admin-connected model connection name you created in the portal. Combined with the
# model name it forms FOUNDRY_MODEL_DEPLOYMENT above.
# The Admin-connected model connection name. Must match the first half of
# FOUNDRY_MODEL_DEPLOYMENT above, or Foundry answers "model not found".
FOUNDRY_GATEWAY_CONNECTION_NAME=foundry-analytics-demo
# How Foundry authenticates to your APIM. Prefer managed-identity: it keeps the "no keys
# anywhere" property. With managed-identity, add a validate-azure-ad-token inbound policy
# in APIM. With subscription-key the key lives in the Foundry CONNECTION, not in this repo.
FOUNDRY_GATEWAY_AUTH=managed-identity

# --- Agent ----------------------------------------------------------------
AGENT_NAME=foundry-live-agent
# Optional: pin a version for controlled rollouts. Empty = latest.
AGENT_VERSION=

# Which harness the BFF talks to: prompt-agent | langgraph
#
#   prompt-agent  Foundry runs the loop; the BFF executes the three function tools.
#   langgraph     a LangGraph graph Foundry runs as a HOSTED AGENT container (spec 018). The
#                 container owns the loop and executes all four tools itself — including the
#                 Microsoft Learn MCP client — so tool rows read `foundry` instead of `bff`.
#                 It is a separate agent in the same project, named in
#                 ai/harness/langgraph/agent.yaml, and deployed with `just hosted-deploy`.
#                 AGENT_NAME above is the PROMPT agent's; this harness reads its own.
AGENT_HARNESS=prompt-agent

# --- Tools ----------------------------------------------------------------
# Public Microsoft Learn MCP server — Streamable HTTP, no API key, no account.
LEARN_MCP_SERVER_URL=https://learn.microsoft.com/api/mcp
# Local markdown corpus behind lookup_knowledge(). Swap for Foundry IQ later.
KNOWLEDGE_DIR=ai/harness/_shared/tools/knowledge
#
# Web search, behind search_web() (spec 013). THE ONE API KEY IN THIS PROJECT — worth reading
# the reason rather than assuming the rule was forgotten:
#
#   The "no keys" rule is about AZURE. Every Azure service here authenticates with Entra ID,
#   and a key for one of them would be a credential where an identity would do. Tavily is a
#   third-party, non-Azure service with no Entra path, so a key is the only way in. It is read
#   by the BFF process only — the browser never sees it, because the browser never executes a
#   function tool — and .env is gitignored.
#
# Get one at https://app.tavily.com (free tier). One credit per search; nothing here loops.
#
# LEAVE IT EMPTY and the app still runs: search_web answers `search_unavailable`, the agent says
# web search is not configured, and the turn completes normally. That is deliberate — a tool
# that raised instead would leave a function call unanswered, and Foundry waits on one of those
# until the run expires ten minutes later.
TAVILY_API_KEY=
#
# The hosted agent (AGENT_HARNESS=langgraph) cannot read this file: it runs in a Foundry-managed
# container, and the hosted-agent documentation is explicit that secrets belong in neither the
# image nor the agent version's environment. It reads the same value from an Azure Key Vault,
# using the dedicated Entra agent identity Foundry creates at deploy time — so the AGENT VERSION
# carries only the vault's address, which is not a secret. Blank here and blank there behave the
# same way: search_web answers `search_unavailable`.
#
# Set it with `azd env set KEY_VAULT_URI https://<vault>.vault.azure.net/` before `azd deploy`;
# the role assignment that makes the read work is in ai/harness/langgraph/README.md (spec 018 AC7).
KEY_VAULT_URI=

# --- Observability --------------------------------------------------------
# Set by `azd up`; the trace drawer queries this workspace.
# The ARM resource id of that same Application Insights — what the trace panel queries (spec 005).
# NOT derivable from the connection string above: `LogsQueryClient.query_resource()` addresses an
# Azure resource, while the connection string carries an `ApplicationId` for a different API. Leave
# it blank and the app runs complete and normal; the trace panel simply says tracing is not
# configured. Reading it needs Log Analytics Reader on the backing workspace.
# /subscriptions/<sub>/resourceGroups/<rg>/providers/microsoft.insights/components/<name>
APPLICATIONINSIGHTS_RESOURCE_ID=

APPLICATIONINSIGHTS_CONNECTION_STRING=
LOG_ANALYTICS_WORKSPACE_ID=

# --- Voice Live -----------------------------------------------------------
# Voice Live NEVER passes through the AI Gateway -- it talks to the Foundry resource
# directly. That is by design, and the architecture doc says so out loud.
#
# Leave VOICELIVE_ENDPOINT empty to derive it from FOUNDRY_PROJECT_ENDPOINT: Voice Live
# lives on the RESOURCE, not on the /api/projects/<project> path.
VOICELIVE_ENDPOINT=
#
# TWO api-versions, one per endpoint. Observed 2026-09-15 -- this is not a typo:
#
#   /voice-live/realtime/calls  (WebRTC control)  works ONLY on 2026-01-01-preview
#                                                 404 on 2026-04-10 and 2026-07-15
#                                                 401 on 2026-06-01-preview
#   /voice-live/realtime        (plain WebSocket) works on all four
#
# Collapsing these into one value silently breaks whichever path it was not chosen for.
VOICELIVE_WEBRTC_API_VERSION=2026-01-01-preview
VOICELIVE_WS_API_VERSION=2026-04-10
#
# How the session sounds and listens (spec 012). These travel INSIDE the rtc.call.sdp.create
# frame, next to the SDP offer -- the shape the WebRTC doc documents. Blank them all and the
# frame goes out exactly as it did before: service defaults, and no configuration at all.
#
# The voice. `azure-standard` covers all three tiers below. The default is the HD tier, chosen by
# listening on 2026-09-16: MAI-Voice-2-Flash is documented as optimized for real-time
# responsiveness, and it is the faster one, but HD is the one that sounds right in Portuguese.
# If first-audio latency matters more to you than naturalness, take the Flash line below.
#
# All of these were accepted by the reference project on 2026-09-15 -- switching is a restart:
#   pt-BR-Luana:MAI-Voice-2-Flash        expressive, low latency  (female, preview)
#   pt-BR-Caio:MAI-Voice-2-Flash         the same, male
#   pt-BR-Thalita:DragonHDLatestNeural   HD; supports `temperature`. Region-limited, eastus is in
#   pt-BR-Macerio:DragonHDLatestNeural   HD, male
#   pt-BR-ThalitaMultilingualNeural      standard neural; the only one documented to read BOTH
#                                        languages natively -- use it if English matters as much
VOICELIVE_VOICE=pt-BR-Thalita:DragonHDLatestNeural
# Turn detection. The documented barge-in control -- `interrupt_response` -- exists ONLY on the
# azure semantic detectors, so on the default `server_vad` there is nothing to configure. The
# multilingual variant is the one that covers Portuguese.
VOICELIVE_VAD=azure_semantic_vad_multilingual
# Optional language hint for input transcription, e.g. `pt`. Empty on purpose: pinning one
# language makes the other half of a bilingual app worse.
VOICELIVE_INPUT_LANGUAGE=

# --- Speech (spoken answers in the text chat, spec 008) -------------------
# Leave both empty to ship without spoken answers: the BFF reports speech as unavailable
# and the header's "Speak" toggle stays disabled, which is the honest state (§5).
#
# SPEECH_ENDPOINT is the Speech resource's CUSTOM SUBDOMAIN host -- take it from the
# resource's "Keys and Endpoint" page. It is NOT derived from FOUNDRY_PROJECT_ENDPOINT:
# whether a given resource answers text to speech on its own host is a property of that
# resource, and guessing it is exactly what constitution §10 forbids.
SPEECH_ENDPOINT=
# The ARM resource id of that resource. This is NOT optional decoration: Entra auth for the
# Speech REST API carries it INSIDE the Authorization header --
#   Authorization: Bearer aad#<resource-id>#<entra-token>
# Read 2026-09-15 from learn.microsoft.com/azure/ai-services/speech-service/how-to-configure-azure-ad-auth
# The caller needs the "Cognitive Services Speech User" role on the resource.
SPEECH_RESOURCE_ID=
# Voice per language (§7). Short names verified 2026-09-15 against the language-support doc.
SPEECH_VOICE_EN=en-US-AvaMultilingualNeural
SPEECH_VOICE_PT=pt-BR-ThalitaMultilingualNeural

# --- What a turn cost (spec 028) ------------------------------------------
# OPTIONAL, and empty is the supported default: with no rates the app shows tokens
# exactly as it does today and shows no money at all. It does NOT show zero.
#
# This repository deliberately ships NO prices. Rates vary by region and by agreement
# and change without telling anyone, so a number compiled in here would be a fact with
# no owner that goes stale in silence (§5). You declare them; you own them.
#
# Read the current numbers from the Foundry / Azure OpenAI pricing page for YOUR region
# and deployment type, and write the date you read them. Rates are per MILLION tokens.
# The three keys are the only ones accepted: input, cached_input, output.
# Reasoning tokens are NOT a key: the service bills them as output tokens and they are
# already counted inside output_tokens -- pricing them again would double-count.
# MODEL_RATES={"gpt-5.5":{"input":0.00,"cached_input":0.00,"output":0.00}}
MODEL_RATES=
# ISO 4217. Rendered as-is; nothing is ever converted.
MODEL_RATES_CURRENCY=USD
# Required whenever MODEL_RATES is set: a rate with no date is a number nobody can
# judge the staleness of. Rendered beside the figure it produced.
MODEL_RATES_RECORDED_AT=

# --- Local dev ------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Where the browser reaches the BFF. Read by Vite at build time, so it lives in
# frontend/.env rather than here if you override it; the default below is what the
# backend's CORS allow-list is written for.
VITE_BFF_URL=http://localhost:8000
# Set to 1 to run tests that hit real Foundry (they are skipped by default).
RUN_INTEGRATION_TESTS=0
