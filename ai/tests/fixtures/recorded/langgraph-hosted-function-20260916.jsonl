{"type": "response.output_item.added", "output_index": 4, "item": {"type": "function_call_output", "id": "fco_0008", "call_id": "call_0006", "output": "{\"query\": \"What does this repository's knowledge base say about its harnesses?\", \"passages\": [{\"text\": \"What the gateway does not tell you\\n\\nThe gateway does not log tool traces. Tool-level detail comes only from Foundry tracing, which lands\\nin Application Insights. Voice Live traffic never passes through any gateway.\", \"source\": \"gateway.md\", \"score\": 1.0357}, {\"text\": \"Harnesses\\n\\nA harness is a way of running the agent loop. The prompt-agent harness lets Foundry run the loop.\\nThe langgraph harness would run the loop in our own container, hosted by Foundry. Both sit behind\\none HarnessAdapter contract and emit the same AgentEvent stream, so the frontend, traces and voice\\nwork with either.\", \"source\": \"architecture.md\", \"score\": 0.5}, {\"text\": \"Two things called AI Gateway\\n\\nThe project-level AI Gateway governs direct model calls. Foundry Agent Service does not route its\\ninternal inference through it. To route the agent's inference through your own Azure API Management\\ninstance you use bring your own model, which is a separate Admin-connected model connection. With\\nthat connection the agent's model is named connection-name/model-name.\", \"source\": \"gateway.md\", \"score\": 0.0667}]}", "status": "in_progress", "response_id": "caresp_0000", "agent_reference": {"type": "agent_reference", "name": "foundry-live-agent-hosted", "version": "2"}}, "sequence_number": 32}
{"type": "response.output_item.done", "output_index": 4, "item": {"type": "function_call_output", "id": "fco_0008", "call_id": "call_0006", "output": "{\"query\": \"What does this repository's knowledge base say about its harnesses?\", \"passages\": [{\"text\": \"What the gateway does not tell you\\n\\nThe gateway does not log tool traces. Tool-level detail comes only from Foundry tracing, which lands\\nin Application Insights. Voice Live traffic never passes through any gateway.\", \"source\": \"gateway.md\", \"score\": 1.0357}, {\"text\": \"Harnesses\\n\\nA harness is a way of running the agent loop. The prompt-agent harness lets Foundry run the loop.\\nThe langgraph harness would run the loop in our own container, hosted by Foundry. Both sit behind\\none HarnessAdapter contract and emit the same AgentEvent stream, so the frontend, traces and voice\\nwork with either.\", \"source\": \"architecture.md\", \"score\": 0.5}, {\"text\": \"Two things called AI Gateway\\n\\nThe project-level AI Gateway governs direct model calls. Foundry Agent Service does not route its\\ninternal inference through it. To route the agent's inference through your own Azure API Management\\ninstance you use bring your own model, which is a separate Admin-connected model connection. With\\nthat connection the agent's model is named connection-name/model-name.\", \"source\": \"gateway.md\", \"score\": 0.0667}]}", "status": "completed", "response_id": "caresp_0000", "agent_reference": {"type": "agent_reference", "name": "foundry-live-agent-hosted", "version": "2"}}, "sequence_number": 33}
